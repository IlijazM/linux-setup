services:
  nginx:
    image: jonasal/nginx-certbot:latest
    container_name: {{ container_name }}
    ports:
      - "80:80"
      - "443:443"
    environment:
#      STAGING: 1
#      DEBUG: 1
      CERTBOT_EMAIL: {{ email }}
    networks:
      - nginx
    volumes:
      - {{ letsencrypt_dir }}:/etc/letsencrypt
      - {{ nginx_dir }}:/etc/nginx/user_conf.d:ro
      - {{ srv_root }}:{{ srv_root }}:ro
    restart: unless-stopped

networks:
  nginx:
    external: true